/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Required secrets (set via `wrangler secret put <NAME>`):
 *   CF_API_TOKEN   - Cloudflare API Token with Analytics: Read permission
 *   CF_ACCOUNT_ID  - Your Cloudflare Account ID (32 hex chars)
 */
 {
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linksocks",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-13",

  "observability": {
    "enabled": true
  },

  "vars": {
    // Base domain for generated hosts, e.g. "example.com". Required for
    // automatic hostnames and custom-host validation.
    "WEB_ZONE": "",
    // Public hostname of this Worker (used to separate control-plane routes
    // from proxied websites). Defaults to WEB_ZONE when empty.
    "BASE_HOST": "",
    // Initial administrator username. ADMIN_PASSWORD must be set as a secret.
    "ADMIN_USERNAME": "admin"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "linksocks",
      // Replace with the id from `wrangler d1 create linksocks`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY",
        "class_name": "Relay"
      },
      {
        "name": "TOKEN",
        "class_name": "Token"
      }
    ]
  },

  "exports": {
    "Relay": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "Token": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}